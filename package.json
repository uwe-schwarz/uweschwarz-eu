{
  "name": "uweschwarz-eu",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run deps:update && bun --watch scripts/serve.ts --dev",
    "build": "bun scripts/build.tsx",
    "agent-form-check": "bun scripts/agent-form-check.mjs",
    "start": "bun scripts/serve.ts",
    "lint": "oxlint --deny-warnings --type-aware",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsc --noEmit",
    "generate:sitemap": "bun scripts/generate-sitemap.ts",
    "generate:llms": "bun scripts/generate-llms.ts",
    "generate:cv": "bun scripts/generate-cv-assets.ts && bun scripts/generate-sitemap.ts",
    "doctor": "react-doctor --scope changed --base main --no-score --blocking warning",
    "doctor:full": "react-doctor --scope full --blocking warning",
    "prepare": "husky",
    "deps:update": "bun scripts/update-dependencies.ts",
    "check": "bun run lint && bun run typecheck && bun run format:check && bun run doctor:full && bun run build",
    "deploy": "bun scripts/deploy.ts"
  },
  "dependencies": {},
  "devDependencies": {
    "@nkzw/oxlint-config": "^2.0.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toast": "^1.3.1",
    "@react-pdf/renderer": "^4.9.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "docx": "^9.14.0",
    "embla-carousel-react": "^8.6.0",
    "husky": "^9.1.7",
    "lucide-react": "^1.61.0",
    "motion": "^14.6.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2005",
    "pixelmatch": "^8.0.0",
    "playwright": "^1.64.1",
    "pngjs": "^7.0.0",
    "postcss": "^8.5.32",
    "react": "^19.3.1",
    "react-doctor": "^0.9.18",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "postcss": "$postcss"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "bun@1.4.4",
  "trustedDependencies": [
    "@swc/core",
    "esbuild"
  ]
}
