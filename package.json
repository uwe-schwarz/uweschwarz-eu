{
  "name": "uweschwarz-eu",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "deps:visual": "bun ./scripts/deps-visual-check.mjs",
    "deps:visual:preview": "next start --hostname 127.0.0.1 --port 3301",
    "deps:visual:install-browser": "playwright install chromium",
    "start": "next start",
    "lint": "oxlint --deny-warnings --type-aware",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsc --noEmit",
    "generate:sitemap": "bun scripts/generate-sitemap.ts",
    "generate:llms": "bun scripts/generate-llms.ts",
    "generate:cv": "bun scripts/generate-cv-assets.ts && bun scripts/generate-sitemap.ts",
    "doctor": "react-doctor --scope changed --base main --no-score --blocking warning",
    "doctor:full": "react-doctor --scope full --blocking warning",
    "prepare": "husky"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toast": "^1.2.23",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-react": "^8.6.0",
    "geist": "^1.7.2",
    "lucide-react": "^1.31.0",
    "motion": "^13.1.0",
    "next": "~16.3.1",
    "next-intl": "^4.13.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.85.0",
    "resend": "^6.20.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "three": "^0.185.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nkzw/oxlint-config": "^1.2.1",
    "@react-pdf/renderer": "^4.6.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/three": "^0.185.4",
    "docx": "^9.7.1",
    "husky": "^9.1.7",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.62.1",
    "pngjs": "^7.0.0",
    "postcss": "^8.5.26",
    "react-doctor": "^0.9.12",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "postcss": "$postcss"
  },
  "trustedDependencies": [
    "@swc/core",
    "esbuild",
    "sharp"
  ]
}
